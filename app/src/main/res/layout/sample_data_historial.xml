<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Item 1 -->
    <include layout="@layout/item_residuo_historial" />

    <!-- Item 2 con datos diferentes simulados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@color/card_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:elevation="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="04/09" android:textColor="@color/black" android:textStyle="bold" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:layout_marginHorizontal="8dp" android:background="@color/text_gray" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3.5" android:gravity="center" android:text="Plástico" android:textColor="@color/black" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:layout_marginHorizontal="8dp" android:background="@color/text_gray" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:gravity="center" android:text="15.0 Kg" android:textColor="@color/black" />
    </LinearLayout>

    <!-- Item 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@color/card_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:elevation="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="05/09" android:textColor="@color/black" android:textStyle="bold" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:layout_marginHorizontal="8dp" android:background="@color/text_gray" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3.5" android:gravity="center" android:text="Metal" android:textColor="@color/black" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:layout_marginHorizontal="8dp" android:background="@color/text_gray" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:gravity="center" android:text="8.5 Kg" android:textColor="@color/black" />
    </LinearLayout>

</LinearLayout>
